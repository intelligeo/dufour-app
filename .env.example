# Dufour.app – Environment variables example
# Copy to .env and fill in the real values before running docker compose up.

# ── PostgreSQL (PostGIS) ────────────────────────────────────────────────────
POSTGIS_HOST=postgres
POSTGIS_PORT=5432
POSTGIS_DB=intelligeo_dufour
POSTGIS_USER=intelligeo_dufour
POSTGIS_PASSWORD=changeme

# ── Backend ports ───────────────────────────────────────────────────────────
PORT=10000
FRONTEND_PORT=10080

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# ── Traccar GNSS tracking ───────────────────────────────────────────────────
# LOCAL DEV (docker compose): Traccar container is on the same Docker network
TRACCAR_URL=http://traccar:8082
# PRODUCTION (Render.com): point to your Traccar VPS – Render cannot expose raw TCP ports
# TRACCAR_URL=http://traccar.intelligeo.net:8082
# Traccar admin username (create via the web UI on first boot)
TRACCAR_USER=admin
# Traccar admin password
TRACCAR_PASSWORD=admin
# Optional: separate Traccar DB credentials (if using shared Postgres)
# TRACCAR_DB_PASSWORD=changeme

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
